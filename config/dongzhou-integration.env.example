# Dongzhou keeps credentials in the local bridge process. Never expose these in H5 files.
DONGZHOU_ORGFLOW_URL=http://127.0.0.1:8030
DONGZHOU_AINPC_URL=http://127.0.0.1:8000
DONGZHOU_KNOWLEDGE_URL=http://127.0.0.1:8080

# Existing OrgFlow organization instance used as the canonical court/office ledger.
DONGZHOU_ORGFLOW_ORG_ID=
DONGZHOU_ORGFLOW_ACTOR=dongzhou-game
DONGZHOU_ORGFLOW_TOKEN=
