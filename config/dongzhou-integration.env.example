# Copy to a secret-managed deployment environment. Never commit real tokens.
DONGZHOU_ENV=production
DONGZHOU_PUBLIC_ORIGIN=https://dongzhou.example.com
DONGZHOU_SESSION_SECRET=replace-with-at-least-32-random-characters
DONGZHOU_DATABASE_PATH=/data/dongzhou-integration.sqlite3
DONGZHOU_WEB_ROOT=/app/web-game

DONGZHOU_ORGFLOW_URL=http://organization:8054
DONGZHOU_ORGFLOW_HMAC_SECRET=replace-with-the-same-32-byte-or-longer-secret-as-orgflow
DONGZHOU_ORGFLOW_HMAC_KEY_ID=dongzhou-v1
DONGZHOU_ORGFLOW_AUDIENCE=org-flow-engine-administration
DONGZHOU_ORGFLOW_ORG_ID=596354f7-c343-5c78-958d-757a9e58fde6
DONGZHOU_ORGFLOW_MANAGER_MEMBER_ID=bb531833-924f-5a59-a148-5d33e3fbface
DONGZHOU_ORGFLOW_HIERARCHY_VERSION=1
# orgFlow's AI provider is injected into docker-compose-dongzhou.yml. Keep the
# API key in the deployment secret manager, never in this repository.
DONGZHOU_ORGFLOW_AI_BASE_URL=https://ai-gateway.example.com/v1
DONGZHOU_ORGFLOW_AI_MODEL=replace-with-a-supported-model
DONGZHOU_ORGFLOW_AI_API_KEY=replace-from-secret-manager
# Stable Dongzhou hero ID to its occupied orgFlow position-slot UUID.
DONGZHOU_ORGFLOW_HERO_SLOTS=DuBo=37b1647d-3542-533e-872c-8d43d0fb0e01,ZuoRu=235b4ac4-51b5-59bb-8430-2ea02c4b0f5b,ZhouYouWang=215c94bb-ab7f-5d89-9b52-672aae75dbd9,GuoShiFu=cc14b24a-356c-5c1b-b5aa-16908ade3a14,ZhengHuanGong=a53493c4-f4f6-54f5-830d-3419208efdd9,ZhengWuGong=0c1bceb0-7b02-56bc-9f46-0fea90cc8f60,GongZiCheng3=5621b505-00dd-52a6-9764-2647c6128ded,ZhengZhuangGong=dfc75f66-d066-520d-8a14-06089e60d1f4,GongZiLu=671918a4-24d5-514e-88bf-378b3c6f4781,ZhengVanguard=aa8f9b95-191b-5285-8c75-dea449cdd09a,ZhengVanguard2=9cb68ae4-6857-5039-b923-ab5808f9a4a7,QinXiangGong=b2734422-0385-5312-af2e-dd76d362f0e7
# Stable Dongzhou hero ID to the active orgFlow member occupying that slot.
DONGZHOU_ORGFLOW_HERO_MEMBERS=DuBo=bb531833-924f-5a59-a148-5d33e3fbface,ZuoRu=e3419e13-7498-5a6b-9259-a2c30aeb5a19,ZhouYouWang=2b53a8dd-c202-59b5-b8d7-b3cfa0fbd347,GuoShiFu=c4e7b927-a6bb-5b1e-b262-0a744cf4a983,ZhengHuanGong=e2239196-90ff-5e63-b258-113a37e705c3,ZhengWuGong=c9e9fe29-0310-5b43-a5fb-c681941f2154,GongZiCheng3=67e37624-98fa-5bf3-a865-2d54f7e063f9,ZhengZhuangGong=786f182a-8cdc-5880-8cdd-498484048b06,GongZiLu=46cbc383-4e04-5ec7-9b28-22689e20f13d,ZhengVanguard=d83d2162-99f3-586e-9161-e55cb8d1f6fc,ZhengVanguard2=a21faded-9c9c-5b2f-81a9-5ecaa8363b72,QinXiangGong=67348125-34c5-5671-b74a-599683141dd6

DONGZHOU_AINPC_URL=http://ainpc-gateway:9130
DONGZHOU_AINPC_TOKEN=replace-with-the-ainpc-service-bearer-token
# Must equal AINPC's ORGANIZATION_TASK_SERVICE_BEARER_TOKEN. This server-only
# token authorizes durable NPC report-dialogue starts and is never sent to H5.
DONGZHOU_AINPC_TASK_TOKEN=replace-with-the-ainpc-task-service-bearer-token
DONGZHOU_AINPC_GAME_SERVER_ID=91001

DONGZHOU_KNOWLEDGE_URL=http://server:8080
DONGZHOU_KNOWLEDGE_TOKEN=replace-with-the-knowledge-service-bearer-token
# Local AKU fallback is deliberately opt-in and should stay disabled in production.
DONGZHOU_OFFLINE_KNOWLEDGE=0
DONGZHOU_UPSTREAM_TIMEOUT_SECONDS=30
